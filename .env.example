# ==============================================================================
# NagrikLens - Environment Variables Example
# Duplicate this file to .env and adjust values for your local environment.
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Backend Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=127.0.0.1
PROJECT_NAME="NagrikLens API"
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-string

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (SQLite default for 48h hackathon)
DATABASE_URL=sqlite:///./nagrik_lens.db

# AI / Gemini API Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Frontend Configuration (Used when building or running Vite)
VITE_API_BASE_URL=http://localhost:8000
